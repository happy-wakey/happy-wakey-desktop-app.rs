# Happy Wakey environment configuration
# Copy this file to .env and fill in your keys.
# Precedence: non-secret CLI flags > system environment > .env > schema defaults.
# Credentials below are environment/secret-store only and have no CLI spelling.

# Supabase (required for auth + cloud sync)
SUPABASE_URL=https://vgzyyfhnendriyrhakkp.supabase.co
SUPABASE_ANON_KEY=

# Happy Wakey product backend (shared-auth + off-app reminder gateway).
# No default. Hostname HTTPS only; loopback HTTP is allowed for local QA.
# HAPPY_WAKEY_PLATFORM_URL=https://platform.example.test
# HAPPY_WAKEY_SHARED_AUTH_URL=http://127.0.0.1:8120/
# HAPPY_WAKEY_GATEWAY_URL=http://127.0.0.1:8128/

# Weather works without a key through Open-Meteo for non-commercial use.
# For a commercial build, configure an Open-Meteo paid customer endpoint + key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# Optional weather fallback
OPENWEATHER_API_KEY=

# Calendar endpoint overrides are for deterministic loopback QA only.
# GOOGLE_CALENDAR_API_URL=http://127.0.0.1:18080/google
# MICROSOFT_CALENDAR_API_URL=http://127.0.0.1:18080/microsoft

# Required for market and headline data
FINNHUB_API_KEY=
NEWSAPI_KEY=

# Optional overrides
GIT_REPO_PATH=
CONFIG_DIR=

# Stable macOS bundle identifier used by the native notification backend.
HAPPY_WAKEY_BUNDLE_ID=com.happywakey.app
